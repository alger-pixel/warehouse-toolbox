FEISHU_APP_ID=YOUR_APP_ID
FEISHU_APP_SECRET=YOUR_SECRET
FEISHU_BASE_APP_TOKEN=YOUR_BASE_TOKEN
FEISHU_PACKAGE_TABLE_ID=YOUR_TABLE_ID
FEISHU_CLIENT_TABLE_ID=YOUR_CLIENT_TABLE_ID
WAREHOUSE_TIME_ZONE=America/Toronto
ALLOWED_ORIGINS=https://alger-pixel.github.io,http://127.0.0.1:5501,http://localhost:5501

# PICKING LIST CLASS table; required for Picking List creation.
FEISHU_PICKING_LIST_TABLE_ID=YOUR_PICKING_LIST_TABLE_ID

# TOOL CLASS: required only for manual metadata sync
FEISHU_TOOL_TABLE_ID=YOUR_TOOL_TABLE_ID

FEISHU_TINECO_TOC_UNIT_TABLE_ID=YOUR_TINECO_TOC_UNIT_TABLE_ID
FEISHU_CASE_CATEGORY_TABLE_ID=YOUR_CASE_CATEGORY_TABLE_ID
FEISHU_CASE_CLASS_TABLE_ID=YOUR_CASE_CLASS_TABLE_ID
FEISHU_OPERATION_NEWS_TABLE_ID=YOUR_OPERATION_NEWS_TABLE_ID
# Reusable controlled Operation News testing; disabled by default. To enable:
# 1. Use production data + development runtime locally.
# 2. Set the flag to enabled and configure a random 32-byte lowercase hex secret.
# 3. Restart port 8787 and verify /api/operation-news/development-status.
# 4. Test normal valid Operation News values from port 5501, then archive test records.
# 5. Clear the flag/secret, restart 8787, and verify writes are blocked again.
# Never copy the local authorization value into this example or wrangler.toml.
OPERATION_NEWS_LOCAL_E2E=
OPERATION_NEWS_LOCAL_E2E_AUTHORIZATION=
FEISHU_SAFETY_ICON_TABLE_ID=YOUR_SAFETY_ICON_TABLE_ID
FEISHU_SOP_TABLE_ID=YOUR_SOP_TABLE_ID
FEISHU_PART_USED_TABLE_ID=YOUR_PART_USED_TABLE_ID
FEISHU_PART_USED_INVENTORY_COUNT_TABLE_ID=YOUR_PART_USED_INVENTORY_COUNT_TABLE_ID

# Worker-only OpenAI command simplifier. Leave blank for raw fallback. Never commit real keys.
OPENAI_API_KEY=
OPENAI_COMMAND_MODEL=

# Temporary, server-controlled safe fallback diagnostics in responses. Disable after investigation.
OPENAI_COMMAND_DIAGNOSTICS=false

# Milestone 1: existing USER CLASS table ID; do not guess.
FEISHU_USER_TABLE_ID=
# Secret-only random administration key (at least 32 characters). Never commit a real value.
USER_MANAGEMENT_ADMIN_KEY=

# Shared warehouse inventory lookup. Worker-only secret; never commit real keys.
MKITE_WAREHOUSE_API_KEY=
# Optional; defaults to this HTTPS endpoint.
MKITE_WAREHOUSE_API_URL=https://tool.mkite.cn/api/v1/open/warehouse-inventory/locations

# Project Management master table (existing Base).
FEISHU_PROJECT_TABLE_ID=YOUR_PROJECT_TABLE_ID
