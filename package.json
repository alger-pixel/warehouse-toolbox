{
  "name": "warehouse-toolbox",
  "private": true,
  "scripts": {
    "worker:dev": "npx wrangler dev --config worker/wrangler.toml --local --port 8787",
    "worker:check": "node scripts/check-worker-config.js",
    "worker:deploy": "npm run worker:check && npx wrangler deploy --config worker/wrangler.toml",
    "frontend:dev": "python3 -m http.server 5501"
  }
}
